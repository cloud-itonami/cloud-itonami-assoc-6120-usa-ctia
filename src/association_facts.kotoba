(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :bool (string=? a "ctia"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (= i 0) true (if (= i 1) true false)) false))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ctia.consumer-code-for-wireless-service")
        (string=? f "title") (option-some-of [:option :string] "Consumer Code for Wireless Service")
        (string=? f "association") (option-some-of [:option :string] "ctia")
        (string=? f "isic") (option-some-of [:option :string] "6120")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://api.ctia.org/wp-content/uploads/2020/03/CTIA-Consumer-Code-2020.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2020-03")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "ctia.smartphone-anti-theft-voluntary-commitment")
        (string=? f "title") (option-some-of [:option :string] "Smartphone Anti-Theft Voluntary Commitment")
        (string=? f "association") (option-some-of [:option :string] "ctia")
        (string=? f "isic") (option-some-of [:option :string] "6120")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://api.ctia.org/docs/default-source/default-document-library/stolen-phone-commitment.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2016-07-26")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 2 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= ti 0) (option-some-of [:option :string] "consumer-protection")
        (if (= ti 1) (if (= i 0) (option-some-of [:option :string] "fair-transaction")
                         (option-some-of [:option :string] "device-security"))
            (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a)
    (if (string=? t "consumer-protection") 2
        (if (string=? t "fair-transaction") 1 (if (string=? t "device-security") 1 0))) 0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (string=? t "consumer-protection")
      (if (= i 0) (entry-field a 0 "id") (if (= i 1) (entry-field a 1 "id") (option-none-of [:option :string])))
      (if (= i 0)
        (if (string=? t "fair-transaction") (entry-field a 0 "id")
            (if (string=? t "device-security") (entry-field a 1 "id") (option-none-of [:option :string])))
        (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
